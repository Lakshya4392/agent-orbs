{
  "name": "@agent-orbs/react",
  "version": "0.1.0",
  "description": "Pixel-perfect React component library and status pills for Agent Orbs",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
